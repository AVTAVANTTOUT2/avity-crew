{
  "schema_version": 1,
  "orchestrator": {
    "provider": "claude",
    "model": null
  },
  "workers": [
    {
      "provider": "claude",
      "model": null
    },
    {
      "provider": "codex",
      "model": null
    }
  ],
  "max_active_agents": 7,
  "language": "fr",
  "context": {
    "input_budget_tokens": 24000,
    "exclude_paths": ["node_modules/", "dist/", "coverage/", ".env", ".git/"]
  },
  "verification_commands": [
    {
      "id": "project-check",
      "argv": ["npm", "run", "check"],
      "cwd": ".",
      "timeout_seconds": 600
    }
  ],
  "workspace_setup": [
    {
      "id": "setup:deps",
      "argv": ["npm", "ci"],
      "cwd": ".",
      "timeout_seconds": 600
    }
  ],
  "delivery": {
    "mode": "branch",
    "target_ref": "main"
  },
  "permissions": {
    "profile": "workspace",
    "allow_production": false,
    "allow_external_publication": false
  }
}
