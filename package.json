{
  "name": "avity-crew",
  "version": "0.2.0",
  "description": "Équipe locale Claude Code et Codex, avec contexte et preuves persistants",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AVTAVANTTOUT2/avity-crew.git"
  },
  "homepage": "https://github.com/AVTAVANTTOUT2/avity-crew#readme",
  "bugs": {
    "url": "https://github.com/AVTAVANTTOUT2/avity-crew/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "multi-agent",
    "cli",
    "local-first"
  ],
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "npm@11.20.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "bin": {
    "avity-crew": "bin/avity-crew.mjs"
  },
  "exports": {
    "./contracts": "./dist/packages/contracts/src/index.js",
    "./core": "./dist/packages/core/src/index.js",
    "./storage": "./dist/packages/storage/src/index.js",
    "./context": "./dist/packages/context/src/index.js",
    "./workspace": "./dist/packages/workspace/src/index.js",
    "./supervisor": "./dist/packages/supervisor/src/index.js",
    "./providers": "./dist/packages/providers/src/index.js",
    "./schema/runtime": "./packages/contracts/schema/runtime.schema.json",
    "./schema/project-config": "./packages/contracts/schema/project-config.schema.json"
  },
  "files": [
    "bin",
    "dist",
    "!dist/tests",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "docs",
    "packages/contracts/schema"
  ],
  "scripts": {
    "generate": "node scripts/generate-contracts.mjs",
    "build": "npm run generate && tsc",
    "typecheck": "npm run generate && tsc --noEmit",
    "test": "npm run build && node --test 'dist/tests/**/*.test.js'",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node bin/avity-crew.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3"
  }
}
